# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: Hugging Face token (faster / more reliable model download)
HF_TOKEN=

# Absolute path to the zstd Reddit dump if it is not at ../threads_2026-01_to_2026-05.jsonl.zst
THREADS_PATH=
USER_HISTORY_PATH=

# Reserved for Kong-aligned metric recomputation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Qwen via DashScope OpenAI-compatible endpoint
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=

# Six-arm scale replay. Empty falls through to model: in configs/scale5000.yaml.
# Names here are API model ids, not the tier labels.
SCALE_HIGH_OPENAI_MODEL=
SCALE_HIGH_QWEN_MODEL=
SCALE_MID_OPENAI_MODEL=
SCALE_MID_DEEPSEEK_MODEL=
SCALE_LOW_DEEPSEEK_MODEL=
SCALE_LOW_QWEN_MODEL=
