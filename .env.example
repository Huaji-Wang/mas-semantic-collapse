# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional: Hugging Face token (faster / more reliable model download)
HF_TOKEN=

# Absolute path to the zstd Reddit dump if it is not at ../threads_2026-01_to_2026-05.jsonl.zst
THREADS_PATH=

# Reserved for Kong-aligned metric recomputation
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
